# OpenAI-compatible endpoint used for translation and summaries.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Required. Put the real value in the environment or GitHub Actions secrets.
LLM_API_KEY=

# Optional tuning.
LLM_POLISH=1
LLM_CONCURRENCY=2
LLM_MAX_ITEMS_PER_RUN=600
SUMMARY_MODEL=

# Site build.
SITE_BASE=
SITE_URL=http://localhost:8000
